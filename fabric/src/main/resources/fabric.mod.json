{
  "schemaVersion": 1,
  "id": "donuttracker",
  "version": "${version}",
  "name": "Donut Tracker + Auctions",
  "description": "One client mod: profit tracker, payment queue, auctions, local custom donut capes, glass HUDs and atmospheres.",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.donuttracker.fabric.DonutTrackerClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "authors": [
    "claude"
  ],
  "breaks": {
    "auctionmod": "*"
  },
  "mixins": [
    "donuttracker.mixins.json"
  ]
}
